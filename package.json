{
  "name": "personal-retirement-planner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix apps/web run dev -- -H 127.0.0.1 -p 3000",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "python -m pytest -q",
    "lint": "python -m ruff check .",
    "reset:db": "python scripts/reset_local_db.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
